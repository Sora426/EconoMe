<!DOCTYPE html>
<html>

<head>

<%- include("../partials/head",{title:"My Favorites"}) %>

</head>

<body>

<%- include("../partials/navbar") %>

<div class="container">

<h1>❤️ My Favorites</h1>

<h2>Articles</h2>

<% if(articles.length===0){ %>

<p>No saved articles.</p>

<% } %>

<% articles.forEach(article=>{ %>

<div class="card">

<h3><%= article.title %></h3>

<p><%= article.description %></p>

<a href="/articles/<%= article.id %>">

Read

</a>

</div>

<% }) %>

<hr>

<h2>Books</h2>

<% if(books.length===0){ %>

<p>No saved books.</p>

<% } %>

<% books.forEach(book=>{ %>

<div class="card">

<h3><%= book.title %></h3>

<p><%= book.author %></p>

<a href="/books/<%= book.id %>">

View

</a>

</div>

<% }) %>

</div>

</body>

</html>