<!DOCTYPE html>
<html>

<head>



<link rel="stylesheet" href="/css/admin.css">

</head>

<body>
    

<div class="admin-layout">

<%- include("sidebar") %>

<div class="admin-content">
<div class="content">

<h1>Edit Article</h1>

<form
action="/admin/articles/update/<%= article.id %>"
method="POST"
enctype="multipart/form-data"
>

<input

name="title"
value="<%= article.title %>">



<input

name="category"
value="<%= article.category %>">

<textarea
name="description"><%= article.description %></textarea>

<label>Preview</label>

<textarea name="preview">
<%- article.preview %>
</textarea>

<br><br>

<label>Full Article</label>

<textarea name="content">
<%- article.content %>
</textarea>

<input
type="hidden"
name="oldImage"
value="<%= article.image %>">
<input type="file" name="image">


<label>

<input
type="checkbox"
name="isPremium"

<%= article.isPremium ? "checked" : "" %>
>

Premium

</label>

<br><br>

<button class="btn">

Update Article

</button>

</form>

</div>
<script
src="https://cdn.tiny.cloud/1/t6igl8ivg17o6kdl1j3qrsqp9fwzsqbxt0kbsighzil50cgk/tinymce/6/tinymce.min.js"
referrerpolicy="origin">
</script>

<script>

tinymce.init({

selector:"textarea",

height:600,

plugins:

"lists link image table code fullscreen",

toolbar:

"undo redo | styles | bold italic underline | \
alignleft aligncenter alignright | \
bullist numlist | \
link image table | code fullscreen"

});

</script>
</body>

</html>