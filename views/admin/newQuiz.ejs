<!DOCTYPE html>
<html>

<head>



<link rel="stylesheet" href="/css/admin.css">

</head>

<body>
    

<div class="admin-layout">

<%- include("sidebar") %>

<div class="admin-content">
<h1>Create Quiz</h1>

<form
action="/admin/quizzes"
method="POST">

<input
type="text"
name="title"
placeholder="Quiz Title"
required>

<br><br>

<input
type="text"
name="category"
placeholder="Category">

<br><br>
<div class="premium-option">

    <label>

        <input
            type="checkbox"
            name="isPremium"
            value="1"
        >

        👑 Premium Quiz

    </label>

    <p>
        Check this if users need EconoMe Premium to take this quiz.
    </p>

</div>
<button>

Create Quiz

</button>

</form>

    
</body>
</html>