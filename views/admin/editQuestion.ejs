<!DOCTYPE html>
<html>

<head>

    <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="admin-layout">

    <%- include("sidebar") %>

    <div class="admin-content">

        <div class="content">

            <h1>Edit Question</h1>

            <form
                action="/admin/questions/update/<%= question.id %>"
                method="POST"
                enctype="multipart/form-data"
            >

                <textarea
                    name="question"
                    required
                ><%= question.question %></textarea>

                <br><br>


                <!-- QUESTION TYPE -->

                <h4>Question Type</h4>

                <select
                    name="type"
                    id="questionType"
                    onchange="changeQuestionType()"
                >

                    <option
                        value="multiple"
                        <%= question.type === "multiple" ? "selected" : "" %>
                    >
                        Multiple Choice
                    </option>

                    <option
                        value="truefalse"
                        <%= question.type === "truefalse" ? "selected" : "" %>
                    >
                        True / False
                    </option>

                </select>

                <br><br>


                <!-- IMAGE -->

                <h4>Question Image</h4>

                <% if(question.image){ %>

                    <img
                        src="/uploads/images/<%= question.image %>"
                        class="question-image"
                        style="max-width:400px; display:block; margin-bottom:15px;"
                    >

                    <label>

                        <input
                            type="checkbox"
                            name="removeImage"
                            value="1"
                        >

                        Remove current image

                    </label>

                    <br><br>

                <% } %>

                <input
                    type="file"
                    name="image"
                    accept="image/*"
                >

                <br><br>


                <!-- MULTIPLE CHOICE -->

                <div id="multipleChoice">

                    <input
                        name="optionA"
                        placeholder="Option A"
                        value="<%= question.optionA || '' %>"
                    >

                    <br><br>

                    <input
                        name="optionB"
                        placeholder="Option B"
                        value="<%= question.optionB || '' %>"
                    >

                    <br><br>

                    <input
                        name="optionC"
                        placeholder="Option C"
                        value="<%= question.optionC || '' %>"
                    >

                    <br><br>

                    <input
                        name="optionD"
                        placeholder="Option D"
                        value="<%= question.optionD || '' %>"
                    >

                    <br><br>

                    <h4>Correct Answer</h4>

                    <select
                        name="correctAnswer"
                        id="multipleCorrectAnswer"
                    >

                        <option
                            value="A"
                            <%= question.correctAnswer === "A" ? "selected" : "" %>
                        >
                            A
                        </option>

                        <option
                            value="B"
                            <%= question.correctAnswer === "B" ? "selected" : "" %>
                        >
                            B
                        </option>

                        <option
                            value="C"
                            <%= question.correctAnswer === "C" ? "selected" : "" %>
                        >
                            C
                        </option>

                        <option
                            value="D"
                            <%= question.correctAnswer === "D" ? "selected" : "" %>
                        >
                            D
                        </option>

                    </select>

                </div>


                <!-- TRUE / FALSE -->

                <div
                    id="trueFalse"
                    style="display:none;"
                >

                    <h4>Correct Answer</h4>

                    <select
                        name="trueFalseAnswer"
                        id="trueFalseAnswer"
                    >

                        <option
                            value="True"
                            <%= question.correctAnswer === "True" ? "selected" : "" %>
                        >
                            True
                        </option>

                        <option
                            value="False"
                            <%= question.correctAnswer === "False" ? "selected" : "" %>
                        >
                            False
                        </option>

                    </select>

                </div>


                <br><br>

                <button type="submit">
                    Update Question
                </button>

            </form>

        </div>

    </div>

</div>


<script>

function changeQuestionType() {

    const type =
        document.getElementById("questionType").value;

    const multipleChoice =
        document.getElementById("multipleChoice");

    const trueFalse =
        document.getElementById("trueFalse");

    const multipleAnswer =
        document.getElementById("multipleCorrectAnswer");

    const trueFalseAnswer =
        document.getElementById("trueFalseAnswer");


    if(type === "multiple") {

        multipleChoice.style.display = "block";

        trueFalse.style.display = "none";

        multipleAnswer.disabled = false;

        trueFalseAnswer.disabled = true;

    }


    if(type === "truefalse") {

        multipleChoice.style.display = "none";

        trueFalse.style.display = "block";

        multipleAnswer.disabled = true;

        trueFalseAnswer.disabled = false;

    }

}


changeQuestionType();

</script>

</body>

</html>