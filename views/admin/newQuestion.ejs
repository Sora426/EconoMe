<!DOCTYPE html>
<html>

<head>



<link rel="stylesheet" href="/css/admin.css">

</head>

<body>
    

<div class="admin-layout">

<%- include("sidebar") %>

<div class="admin-content">
<div class="content">

<h1>

Add Question

</h1>

<form
    action="/admin/quizzes/<%= quiz.id %>/questions"
    method="POST"
    enctype="multipart/form-data"
>

    <textarea
        name="question"
        placeholder="Question"
        required
    ></textarea>

    <br><br>


    <!-- QUESTION TYPE -->

    <h4>Question Type</h4>

    <select
        name="type"
        id="questionType"
        onchange="changeQuestionType()"
    >

        <option value="multiple">
            Multiple Choice
        </option>

        <option value="truefalse">
            True / False
        </option>

    </select>

    <br><br>


    <!-- OPTIONAL IMAGE -->

    <h4>Question Image (Optional)</h4>

    <input
        type="file"
        name="image"
        accept="image/*"
    >

    <br><br>


    <!-- MULTIPLE CHOICE -->

    <div id="multipleChoice">

        <input
            name="optionA"
            placeholder="Option A"
        >

        <br><br>

        <input
            name="optionB"
            placeholder="Option B"
        >

        <br><br>

        <input
            name="optionC"
            placeholder="Option C"
        >

        <br><br>

        <input
            name="optionD"
            placeholder="Option D"
        >

        <br><br>

        <h4>Correct Answer</h4>

        <select name="correctAnswer" id="multipleCorrectAnswer">

            <option value="A">A</option>

            <option value="B">B</option>

            <option value="C">C</option>

            <option value="D">D</option>

        </select>

    </div>


    <!-- TRUE / FALSE -->

    <div
        id="trueFalse"
        style="display:none;"
    >

        <h4>Correct Answer</h4>

        <select name="trueFalseAnswer" id="trueFalseAnswer">

            <option value="True">
                True
            </option>

            <option value="False">
                False
            </option>

        </select>

    </div>


    <br><br>

    <button type="submit">
        Save Question
    </button>

</form>

</div>
<script>

function changeQuestionType() {

    const type = document.getElementById("questionType").value;

    const multipleChoice =
        document.getElementById("multipleChoice");

    const trueFalse =
        document.getElementById("trueFalse");

    const multipleAnswer =
        document.getElementById("multipleCorrectAnswer");

    const trueFalseAnswer =
        document.getElementById("trueFalseAnswer");


    if (type === "multiple") {

        multipleChoice.style.display = "block";

        trueFalse.style.display = "none";

        multipleAnswer.disabled = false;

        trueFalseAnswer.disabled = true;

    }


    if (type === "truefalse") {

        multipleChoice.style.display = "none";

        trueFalse.style.display = "block";

        multipleAnswer.disabled = true;

        trueFalseAnswer.disabled = false;

    }

}

</script>
</body>

</html>