<!DOCTYPE html>
<html>

<head>

    <%- include("../partials/head",{title:quiz.title}) %>

    <link rel="stylesheet" href="/css/quizshow.css">

</head>

<body>

<%- include("../partials/navbar") %>

<div class="content">

    <h1>
        <%= quiz.title %>
    </h1>


    <form
        action="/quizzes/<%= quiz.id %>/submit"
        method="POST"
    >


        <% questions.forEach((q,index)=>{ %>

            <div class="card">

                <h3>
                    Question <%= index+1 %>
                </h3>


                <div class="question-header">

    <p class="question-text">
        <%= q.question %>
    </p>

    <% if(q.image){ %>

        <img
            src="/uploads/images/<%= q.image %>"
            class="question-image"
            alt="Question image"
        >

    <% } %>

</div>


                <!-- MULTIPLE CHOICE -->

                <% if(q.type === "multiple"){ %>

                    <label class="option">

                        <span class="option-text">
                            <%= q.optionA %>
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="A"
                            required
                        >

                    </label>


                    <label class="option">

                        <span class="option-text">
                            <%= q.optionB %>
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="B"
                        >

                    </label>


                    <label class="option">

                        <span class="option-text">
                            <%= q.optionC %>
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="C"
                        >

                    </label>


                    <label class="option">

                        <span class="option-text">
                            <%= q.optionD %>
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="D"
                        >

                    </label>


                <% } %>


                <!-- TRUE / FALSE -->

                <% if(q.type === "truefalse"){ %>

                    <label class="option">

                        <span class="option-text">
                            True
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="True"
                            required
                        >

                    </label>


                    <label class="option">

                        <span class="option-text">
                            False
                        </span>

                        <input
                            type="radio"
                            name="question_<%= q.id %>"
                            value="False"
                        >

                    </label>

                <% } %>


            </div>

        <% }) %>


        <button type="submit">
            Submit Quiz
        </button>


    </form>

</div>

</body>

</html>