<!DOCTYPE html>
<html>

<head>

    <%- include("../partials/head",{title:"Quizzes"}) %>

    <link rel="stylesheet" href="/css/quiz.css">

</head>

<body>

    <%- include("../partials/navbar") %>

    <div class="content">

        <h1>Economics Quizzes</h1>

        <% quizzes.forEach(quiz=>{ %>

            <div class="card">

                <div class="quiz-info">

                    <div class="quiz-title-row">

                        <h2><%= quiz.title %></h2>

                        <% if (quiz.isPremium) { %>

                            <span class="premium-badge">
                                Premium
                            </span>

                        <% } else { %>

                            <span class="free-badge">
                                Free
                            </span>

                        <% } %>

                    </div>

                    <p>
                        <%= quiz.category %>
                    </p>

                </div>

                <a href="/quizzes/<%= quiz.id %>">
                    Take Quiz
                </a>

            </div>

        <% }) %>

    </div>

</body>

</html>