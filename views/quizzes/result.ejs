<!DOCTYPE html>
<html>

<head>

<%- include("../partials/head",{title:"Quiz Result"}) %>
<link rel="stylesheet" href="/css/result.css">
</head>

<body>

<%- include("../partials/head",{title:"Quiz Result"}) %>

<%- include("../partials/navbar") %>

<div class="content">

    <h1>Quiz Result</h1>

    <div class="score">
        Score: <%= score %> / <%= total %>
    </div>

    <div class="percentage">
        <%= Math.round(score * 100 / total) %>%
    </div>


    <% results.forEach((r,index)=>{ %>

        <div class="card">

            <div class="question-number">
                Question <%= index+1 %>
            </div>


            <h3 class="question">
                <%= r.question %>
            </h3>


            <!-- QUESTION IMAGE -->

            <% if(r.image){ %>

                <img
                    src="/uploads/images/<%= r.image %>"
                    class="question-image"
                    alt="Question image"
                >

            <% } %>


            <!-- YOUR ANSWER -->

            <div class="answer-box">

                <p>
                    <strong>Your Answer</strong>
                </p>

                <% if(r.userAnswer){ %>

                    <p>

                        <% if(r.type === "truefalse"){ %>

                            <%= r.userAnswer %>

                        <% } else { %>

                            <%= r.userAnswer %>
                            -
                            <%= r.options[r.userAnswer] %>

                        <% } %>

                    </p>

                <% } else { %>

                    <p>
                        No Answer
                    </p>

                <% } %>

            </div>


            <!-- CORRECT ANSWER -->

            <div class="answer-box">

                <p>
                    <strong>Correct Answer</strong>
                </p>

                <p>

                    <% if(r.type === "truefalse"){ %>

                        <%= r.correctAnswer %>

                    <% } else { %>

                        <%= r.correctAnswer %>
                        -
                        <%= r.options[r.correctAnswer] %>

                    <% } %>

                </p>

            </div>


            <!-- RESULT -->

            <% if(r.correct){ %>

                <div class="status correct-status">

                    ✔ Correct

                </div>

            <% } else { %>

                <div class="status wrong-status">

                    ✘ Incorrect

                </div>

            <% } %>

        </div>

    <% }) %>


    <a href="/quizzes">
        Back to Quizzes
    </a>

</div>
</body>

</html>