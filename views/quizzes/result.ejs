<!DOCTYPE html>
<html>

<head>

<%- include("../partials/head",{title:"Quiz Result"}) %>
<link rel="stylesheet" href="/css/result.css">
</head>

<body>

<%- include("../partials/navbar") %>

<div class="content">

<h1>Your Result</h1>

<h2>

Score: <%= score %> / <%= total %>

</h2>

<h3 class="persentshow">

<%= Math.round(score*100/total) %>%

</h3>

<hr>

<% results.forEach((r,index)=>{ %>

<div class="result-card <%= r.correct ? 'correct' : 'wrong' %>">

    <div class="question-number">

        Question <%= index+1 %>

    </div>

    <h3 class="question">

        <%= r.question %>

    </h3>

    <div class="answer-box">

        <p>

            <strong>Your Answer</strong>

        </p>

        <p>

            <%= r.userAnswer || "No Answer" %>

            <% if(r.userAnswer){ %>

                -

                <%= r.options[r.userAnswer]%>

            <% } %>

        </p>

    </div>

    <div class="answer-box">

        <p>

            <strong>Correct Answer</strong>

        </p>

        <p>

            <%= r.correctAnswer %>

            -

            <%= r.options[r.correctAnswer] %>

        </p>

    </div>

    <% if(r.correct){ %>

        <div class="status correct-status">

            ✔ Correct

        </div>

    <% }else{ %>

        <div class="status wrong-status">

            ✘ Incorrect

        </div>

    <% } %>

</div>

<% }) %>

<a href="/quizzes">

Back to Quizzes

</a>

</div>
<div id="money-rain"></div>

<script src="/js/moneyRain.js"></script>

<% if((Math.round(score*100/total)) >= 85){ %>

<script>

startMoneyRain();

</script>

<% } %>
</body>

</html>