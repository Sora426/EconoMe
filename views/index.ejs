<!DOCTYPE html>
<html lang="en">

<head>

<%- include("partials/head", { title: "EconoMe" }) %>

</head>

<body>

<%- include("partials/navbar") %>

<!-- Hero Section -->
<section class="hero">

    <div class="hero-image">
        <img src="/images/Adobe Express - file.png" alt="Joan Robinson">
    </div>

    <div class="hero-content">
        <h1>
            “The purpose of studying economics is not to acquire a set of ready-made answers to economic questions, but to learn how to avoid being deceived by economists.”
        </h1>

        <p>― Joan Robinson</p>

        <div class="hero-buttons">
            <a href="/articles" class="btn-primary">Explore Ariticles</Article></a>
            <a href="/quizzes" class="btn-secondary">Quizzes</a>
        </div>
    </div>

</section>



<section class="featured">

<h2>Latest Articles</h2>

<div class="card-grid">

<% articles.forEach(article=>{ %>

<div class="card">

<h3><%= article.title %></h3>

<p><%= article.description %></p>

<a href="/articles/<%= article.id %>">

Read →

</a>

</div>

<% }) %>

</div>

</section>
